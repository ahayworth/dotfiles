#!/bin/bash
# chezmoi modify script: emit the managed content, then preserve any trailing
# marked block that machine-local tooling appends to the live file (generic
# shape: a comment line ">>> ... >>>" through the matching "<<< ... <<<").
# Managed content: .chezmoitemplates/vimrc.tmpl
set -euo pipefail
cat <<'CHEZMOI_MANAGED_CONTENT'
{{ template "vimrc.tmpl" . -}}
CHEZMOI_MANAGED_CONTENT
exec awk '
  /^["#] >>> .* >>>$/ { inblk = 1; print "" }
  inblk { print }
  /^["#] <<< .* <<<$/ { inblk = 0 }
'
