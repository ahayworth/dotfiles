[ -d ~/bin ] && export PATH=${PATH}:~/bin
[ -d ~/.local/bin ] && export PATH=${PATH}:~/.local/bin
[ -d ~/.opencode/bin ] && export PATH=${PATH}:~/.opencode/bin
[ -d ~/.lmstudio/bin ] && export PATH=${PATH}:~/.lmstudio/bin
[[ -f ~/.cargo/env ]] && . "$HOME/.cargo/env"

# Route GnuPG passphrase prompts to this terminal, including SSH sessions.
if [ -t 0 ]; then
  GPG_TTY=$(tty)
  export GPG_TTY
fi

# after the PATH additions, so ~/.local/bin editors count
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
elif command -v vim >/dev/null 2>&1; then
  export EDITOR=vim
  export VISUAL=vim
else
  export EDITOR=vi
  export VISUAL=vi
fi

{{ if not (or .mac .devbox) -}}
# start ssh-agent if it's not running (macOS uses launchd)
ps -ef | grep -q '[s]sh-agent' || eval $(ssh-agent) >/dev/null
{{ end -}}
