{{- $mac := eq .chezmoi.os "darwin" -}}
{{- $laptop := false -}}
{{- $work := false -}}

{{- /* devbox: detect without prompting, via filesystem markers + hostname
       (env vars aren't visible to every shell) */ -}}
{{- $devbox := false -}}
{{- if stat "/etc/workstation-startup.d" -}}
{{-   if or (stat (joinPath .chezmoi.homeDir "agentd/workstation.env")) (env "AGENTD_HOME") (.chezmoi.hostname | contains "devbox") -}}
{{-     $devbox = true -}}
{{-   end -}}
{{- end -}}

{{- if $devbox -}}
{{- /* a work machine, but not a laptop */ -}}
{{-   $work = true -}}
{{- else -}}
{{-   $laptop = promptBoolOnce . "laptop" "Is this a laptop" -}}
{{-   $work = promptBoolOnce . "work" "Is this a work machine" -}}
{{- end -}}

sourceDir = {{ joinPath "~/projects/dotfiles" | quote }}
encryption = "gpg"

[data]
  mac = {{ $mac }}
  laptop = {{ $laptop }}
  work = {{ $work }}
  devbox = {{ $devbox }}
  homebrew_prefix = "/opt/homebrew"

[gpg]
  symmetric = true
