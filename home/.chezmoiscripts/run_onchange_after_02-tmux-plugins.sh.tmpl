#!/bin/bash
set -euo pipefail

# hash: {{ include ".chezmoitemplates/tmux/common.conf.tmpl" | sha256sum }}
# hash: {{ include "dot_tmux.conf.tmpl" | sha256sum }}

if [ -x ~/.tmux/plugins/tpm/bin/install_plugins ]; then
  TMUX_PLUGIN_MANAGER_PATH=~/.tmux/plugins ~/.tmux/plugins/tpm/bin/install_plugins || true
fi

{{ if .devbox -}}
# re-source only our include, not all of ~/.tmux.conf
if tmux info >/dev/null 2>&1; then
  tmux source-file -q ~/.config/tmux/personal.conf || true
fi
{{- else -}}
if [ -n "${TMUX:-}" ]; then
  tmux source-file ~/.tmux.conf || true
fi
{{- end }}
