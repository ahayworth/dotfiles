# Shared tmux config. Everything in this partial must stay safe on a shared
# tmux server: no kill bindings, no default-terminal/update-environment
# overrides, modest history.

# Set the prefix to ^A, like screen
unbind C-b
set -g prefix ^A
bind a send-prefix

bind ^a last-window # toggle last window like screen

# Rebind prefix to b (and back)
bind B set -g prefix ^b
bind A set -g prefix ^a

# split windows like vim
# vim's definition of a horizontal/vertical split is reversed from tmux's
bind ^s split-window -v
bind ^v split-window -h

# move around panes with hjkl, as one would in vim after pressing ctrl-w
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind ^h select-pane -L
bind ^j select-pane -D
bind ^k select-pane -U
bind ^l select-pane -R

# resize panes like vim
# feel free to change the "1" to however many lines you want to resize by, only
# one at a time can be slow
bind < resize-pane -L 10
bind > resize-pane -R 10
bind - resize-pane -D 10
bind + resize-pane -U 10

# session management
bind C new-session
bind L choose-session

# vi-style controls for copy mode
setw -g mode-keys vi

# Create a new window and prompt for name
bind N command-prompt "new-window -n '%%'"

unbind c; bind c new-window -c "#{pane_current_path}"
unbind s; bind s split-window -v -c "#{pane_current_path}"
unbind v; bind v split-window -h -c "#{pane_current_path}"

# reload this config with C-a r
{{- if .devbox }}
bind r source ~/.config/tmux/personal.conf
{{- else }}
bind r source ~/.tmux.conf
{{- end }}

# let us use utf-8 drawing characters to make tab-like window formats
set -g status-style bg=default,fg=colour223

# left side of status bar holds "(>- session name -<)"
set -g status-left-length 100
set -g status-left-style bg=colour142,fg=colour234,bold
set -g status-left ''

# right side of status bar holds "[host name] (date time)"
set -g status-right-length 100
{{- if .laptop }}
set -g status-right '#[fg=colour172,bg=colour234,bold]#{battery_color_fg}#{battery_icon_status}#{battery_percentage} #{battery_remain}#[fg=colour172,bg=colour234,bold] #{user}@#{host}:#{session_name} %Y-%m-%d %H:%M '
{{- else }}
set -g status-right '#[fg=colour172,bg=colour234,bold]#{user}@#{host}:#{session_name} %Y-%m-%d %H:%M '
{{- end }}

# make background window look like white tab
set-window-option -g window-status-style bg=default,fg=colour223,none
set-window-option -g window-status-format '#[fg=colour223,bg=colour237] #I #[fg=colour223,bg=colour237] #W #[default]'

# make foreground window look like bold yellow foreground tab
set-window-option -g window-status-current-style none
set-window-option -g window-status-current-format '#[fg=colour234,bg=colour214] #I #[fg=colour229,bg=colour234] #W #[default]'

# active terminal yellow border, non-active white
set -g pane-border-style bg=default,fg=colour234
set -g pane-active-border-style bg=default,fg=colour172

# more scrollback plz (less on the devbox)
set -g history-limit {{ if .devbox }}50000{{ else }}500000{{ end }}

# neovim in tmux causes delay when pressing ESC, this reduces it
set -g escape-time 0 # ms

set -g repeat-time 200

set-option -g focus-events on

set -g allow-passthrough on

set -g set-titles on
set -g set-titles-string "#S@#H"

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'soyuka/tmux-current-pane-hostname'
set -g @plugin 'christoomey/vim-tmux-navigator'

{{- if .laptop }}
set -g @plugin 'tmux-plugins/tmux-battery'
set -g @batt_remain_short true
{{- end }}

run -b ~/.tmux/plugins/tpm/tpm
